# Groq Cloud API Configuration
# Sign up and obtain an API key from https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here

# Groq Model ID (Defaults to openai/gpt-oss-20b)
GROQ_MODEL=openai/gpt-oss-20b

# Local Server Port (Render.com will automatically assign process.env.PORT)
PORT=8085
